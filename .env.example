# ==============================================================================
# DhanMITR - Environment Variables Template
# Copy this file to .env and configure keys for your local environment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. UI (Next.js Frontend)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="DhanMITR"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BACKEND_API_URL="http://localhost:8000"
NEXT_PUBLIC_ENABLE_MOCK_SERVICES="true"

# Supabase Auth & Database (Frontend + Backend)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 2. Backend Orchestration Layer (FastAPI)
# ------------------------------------------------------------------------------
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
BACKEND_DEBUG=true
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
JWT_SECRET_KEY="supersecret_dhanmitr_jwt_key_change_in_production"
JWT_ALGORITHM="HS256"

# Microservice endpoints (if running services independently in production)
RAG_SERVICE_URL="http://localhost:8001"
VOICE_SERVICE_URL="http://localhost:8002"

# ------------------------------------------------------------------------------
# 3. RAG / AI Intelligence Layer
# ------------------------------------------------------------------------------
# Choose primary LLM Provider: 'openai' | 'anthropic' | 'gemini' | 'groq' | 'mock'
LLM_PROVIDER="mock"
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GEMINI_API_KEY="AIza..."
GROQ_API_KEY="gsk_..."

# Live Data Feeds & Real-time Web Search
TAVILY_API_KEY=""              # Tavily Web Search API (https://tavily.com)
METALS_DEV_API_KEY=""          # Metals.Dev Live Gold/Silver Prices (https://metals.dev)
COINGECKO_API_KEY=""          # CoinGecko Demo API Key (Optional)
TWELVE_DATA_API_KEY=""        # Twelve Data Forex Exchange Rates (Optional)

# Embeddings & Vector Database
EMBEDDING_PROVIDER="openai" # 'openai' | 'huggingface' | 'mock'
VECTOR_DB_TYPE="chroma"     # 'chroma' | 'pinecone' | 'pgvector'
PINECONE_API_KEY=""
PINECONE_ENVIRONMENT=""
PINECONE_INDEX_NAME="dhanmitr-finance"

# ------------------------------------------------------------------------------
# 4. Voice System (STT / TTS)
# ------------------------------------------------------------------------------
# Speech to Text: 'deepgram' | 'whisper' | 'mock'
STT_PROVIDER="mock"
DEEPGRAM_API_KEY=""

# Text to Speech: 'elevenlabs' | 'edge_tts' | 'mock'
TTS_PROVIDER="mock"
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM" # e.g. Rachel / Prem

# Audio Streaming Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=1024
