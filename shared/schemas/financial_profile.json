{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserFinancialProfile",
  "description": "Comprehensive financial profile of an onboarded user.",
  "type": "object",
  "properties": {
    "user_id": { "type": "string" },
    "currency": { "type": "string", "default": "INR" },
    "monthly_income": { "type": "number", "minimum": 0 },
    "monthly_expenses": { "type": "number", "minimum": 0 },
    "emergency_fund_balance": { "type": "number", "minimum": 0 },
    "total_investments": { "type": "number", "minimum": 0 },
    "total_liabilities": { "type": "number", "minimum": 0 },
    "risk_tolerance": {
      "type": "string",
      "enum": ["conservative", "moderate", "aggressive"]
    },
    "employment_type": {
      "type": "string",
      "enum": ["salaried", "self_employed", "freelancer", "student", "retired"]
    },
    "tax_regime": {
      "type": "string",
      "enum": ["new", "old", "not_applicable"],
      "default": "new"
    },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "required": ["user_id", "currency", "monthly_income"]
}
