{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Subscription",
  "description": "Recurring service subscription tracking.",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "user_id": { "type": "string" },
    "name": { "type": "string" },
    "amount": { "type": "number" },
    "currency": { "type": "string", "default": "INR" },
    "billing_cycle": {
      "type": "string",
      "enum": ["monthly", "quarterly", "yearly", "weekly"]
    },
    "category": { "type": "string" },
    "next_renewal_date": { "type": "string", "format": "date" },
    "is_active": { "type": "boolean", "default": true }
  },
  "required": ["id", "name", "amount", "billing_cycle"]
}
