# ==============================================================================
# DhanMITR Monorepo - Root .gitignore
# ==============================================================================

# Node / Next.js
node_modules/
.next/
out/
build/
dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.turbo

# Python / Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Keep example files tracked
!.env.example

# Vector DB / Local Stores / Embeddings Cache
chroma_data/
chroma_db/
vector_store/
*.faiss
*.index
*.sqlite3
*.db

# Audio / Voice temporary files
*.wav
*.mp3
*.ogg
*.flac
*.m4a
audio_cache/
temp_audio/

# Logs & Runtime Dumps
logs/
*.log
*.pid
*.seed

# IDEs and OS Metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
